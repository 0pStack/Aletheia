# Node 1
PORT=3001
PEERS=ws://localhost:3002

# For node 2, use:
# PORT=3002
# PEERS=ws://localhost:3001

# Public keys of the other nodes (*.public.pem). This node's own key is always trusted.
# TRUSTED_NODE_KEYS_DIR=./keys/trusted

# Signs the session cookie. Required when NODE_ENV=production. Left empty, a random secret
# is made on every start, so logins do not survive a restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Only send the session cookie over HTTPS. Defaults to true when NODE_ENV=production.
# SESSION_COOKIE_SECURE=false

# Behind a proxy that terminates HTTPS, the number of proxy hops to trust, so the Secure
# cookie is still set. Leave unset when clients connect directly.
# TRUST_PROXY=1
